# Your submission repository is graded partly on hygiene. Keep this file.
__pycache__/
*.pyc
.venv/
data/
*.log

# Secrets. .dockerignore keeps files out of an image; it does NOT stop git committing them.
.env
.env.*
*.pem
*.key
*credentials*.json
azure.json

# Evidence is graded, so nothing above may swallow it - e.g. a *.log capture.
!evidence/**
