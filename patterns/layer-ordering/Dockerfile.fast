# syntax=docker/dockerfile:1

# RIGHT ORDER — the only difference from Dockerfile.slow is where `COPY . .` sits.
#
# Dependency manifests are copied and installed first. They change rarely, so that layer
# stays cached. Source is copied last, because it changes constantly.
#
#   docker build -f Dockerfile.fast -t demo:fast .
#
# Edit index.js, rebuild, and you will see CACHED on the npm ci line.
#
# The rule: order instructions from least to most frequently changing.

FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --omit=dev

COPY . .

CMD ["node", "index.js"]
