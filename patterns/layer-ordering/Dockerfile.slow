# syntax=docker/dockerfile:1

# WRONG ORDER — kept deliberately, so you can build it and watch the cache miss.
#
# `COPY . .` lands before the dependency install, so any change to any source file
# invalidates that layer, and every layer after it. Dependencies reinstall on every
# single build.
#
# Build it, edit index.js, build again, and read the output:
#
#   docker build -f Dockerfile.slow -t demo:slow .
#
# You will not see CACHED on the npm ci line.

FROM node:22-bookworm-slim

WORKDIR /app

COPY . .

RUN npm ci --omit=dev

CMD ["node", "index.js"]
